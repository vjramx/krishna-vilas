# Krishna Vilas — environment template (names only, never commit real secrets)
# Vite exposes ONLY variables prefixed with VITE_ to the browser. Never put
# service-role or secret keys here.

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase ANON / publishable key (safe for browsers — protected by RLS)
VITE_SUPABASE_ANON_KEY=

# Canonical public URL of the deployed website (no trailing slash).
# Used for Google OAuth redirect config in Supabase Auth.
VITE_PUBLIC_SITE_URL=http://localhost:5173
